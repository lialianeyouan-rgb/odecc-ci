generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Article {
  id        Int            @id @default(autoincrement())
  title     String
  summary   String
  content   String         @db.Text
  category  String
  date      String
  imageUrl  String?
  videoUrl  String?
  pdfUrl    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  images    ArticleImage[]
}

model ArticleImage {
  id        Int      @id @default(autoincrement())
  articleId Int
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Album {
  id          Int          @id @default(autoincrement())
  title       String
  description String?      @db.Text
  coverUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      AlbumImage[]
}

model AlbumImage {
  id        Int      @id @default(autoincrement())
  albumId   Int
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  lastName  String
  firstName String
  address   String
  phone     String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Don {
  id        Int      @id @default(autoincrement())
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("XOF")
  donorName String?
  email     String?
  note      String?  @db.Text
  createdAt DateTime @default(now())
}

model Inscription {
  id        Int      @id @default(autoincrement())
  email     String
  fullName  String?
  type      String
  createdAt DateTime @default(now())
}
